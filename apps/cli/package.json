{
  "name": "@agentplan/cli",
  "version": "0.1.0",
  "description": "CLI for planning, approving, applying and auditing AI agent actions.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentplan": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentplan/adapter-filesystem": "workspace:*",
    "@agentplan/adapter-http": "workspace:*",
    "@agentplan/adapter-shell": "workspace:*",
    "@agentplan/core": "workspace:*",
    "@agentplan/dashboard": "workspace:*",
    "yaml": "2.9.0"
  }
}
